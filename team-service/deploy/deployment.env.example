# Copy outside the package; no passwords belong in this file.
TERMTERM_CONFIG_DIR=/etc/termterm-team-private/config
TERMTERM_DOMAIN=team.company.example
TERMTERM_SERVICE_IMAGE=termterm/team-service:0.4.2
TERMTERM_TEAM_CPUS=1.0
TERMTERM_TEAM_MEMORY=512m
TERMTERM_HTTPS_CPUS=0.5
TERMTERM_HTTPS_MEMORY=128m
# Only with compose.postgres.yaml:
TERMTERM_PRIVATE_DIR=/etc/termterm-team-private
TERMTERM_PG_PORT=55433
TERMTERM_PG_CPUS=2.0
TERMTERM_PG_MEMORY=1g
# Internal HTTPS CA: use an absolute path; distribute its PUBLIC CA to clients.
# TERMTERM_CADDY_FILE=/opt/termterm-team/deploy/Caddyfile.internal
