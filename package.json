{
  "name": "termterm",
  "private": true,
  "version": "0.5.0-dev.12",
  "type": "module",
  "scripts": {
    "db:prepare": "node scripts/prepare-database.mjs",
    "db:catalog": "node scripts/extract-db-catalog.mjs",
    "db:dev": "tauri dev --config src-tauri/tauri.database-dev.conf.json",
    "db:build": "tauri build --debug --no-bundle --config src-tauri/tauri.database-dev.conf.json",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev --config src-tauri/tauri.team-dev.conf.json",
    "team:dev": "tauri dev --config src-tauri/tauri.team-dev.conf.json",
    "team:build": "tauri build --debug --no-bundle --config src-tauri/tauri.team-dev.conf.json",
    "package": "tauri build",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:native": "wdio run wdio.conf.mjs",
    "test:ui": "playwright test",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.577.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@wdio/cli": "^9.31.9",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.9",
    "@wdio/mocha-framework": "^9.31.9",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-plugin": "^1.4.0",
    "@wdio/tauri-service": "^1.4.0",
    "prettier": "^3.9.7",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
