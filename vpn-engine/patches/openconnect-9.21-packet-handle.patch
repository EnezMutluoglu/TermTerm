+/* TermTerm broker pipes carry complete IP packets, never a byte stream. */
+static int valid_packet_message(const unsigned char *data, int len)
+{
+	if (len < 20 || len > 65535)
+		return 0;
+	if ((data[0] >> 4) == 4)
+		return (data[0] & 15) >= 5 && (data[0] & 15) * 4 <= len &&
+		       (((unsigned)data[2] << 8) | data[3]) == (unsigned)len;
+	if ((data[0] >> 4) == 6)
+		return len >= 40 && ((((unsigned)data[4] << 8) | data[5]) + 40) == (unsigned)len;
+	return 0;
+}
