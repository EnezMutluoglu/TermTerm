+int openconnect_setup_tun_packet_handle(struct openconnect_info *vpninfo, intptr_t packet_handle)
+{
+	HANDLE pipe = (HANDLE)packet_handle, read_event, write_event;
+	DWORD flags, mode;
+	if (!vpninfo || !pipe || pipe == INVALID_HANDLE_VALUE || vpninfo->wintun ||
+	    vpninfo->vpnc_script || vpninfo->tun_fh != INVALID_HANDLE_VALUE ||
+	    GetFileType(pipe) != FILE_TYPE_PIPE ||
+	    !GetNamedPipeInfo(pipe, &flags, NULL, NULL, NULL) || !(flags & PIPE_TYPE_MESSAGE) ||
+	    !GetNamedPipeHandleState(pipe, &mode, NULL, NULL, NULL, NULL, 0) || !(mode & PIPE_READMODE_MESSAGE))
+		return -EINVAL;
+	read_event = CreateEvent(NULL, FALSE, FALSE, NULL);
+	if (!read_event)
+		return -EIO;
+	write_event = CreateEvent(NULL, FALSE, FALSE, NULL);
+	if (!write_event) {
+		CloseHandle(read_event);
+		return -EIO;
+	}
+	vpninfo->tun_fh = pipe;
+	vpninfo->tun_rd_overlap.hEvent = read_event;
+	vpninfo->tun_wr_overlap.hEvent = write_event;
+	vpninfo->tun_packet_handle = 1;
+	monitor_read_fd(vpninfo, tun);
+	return 0;
 }
 
