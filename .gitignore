# Downloaded dependencies and generated build/test output
node_modules/
/dist/
/src-tauri/target/
/team-service/target/
/team-client/target/
/src-tauri/gen/
/src-tauri/resources/mosh/
/src-tauri/resources/mosh-native/
*.tsbuildinfo
/playwright-report/
/test-results/

# Local tools, credentials, vaults and release packages stay on this computer
/.tools/
/.lab/
/artifacts/
*.ttvault*
*.ttbackup
*.ttcache*
*.ttlogin
*.ttpolicy*
*.ttrecovery
*.ttteam*
*.log
*.pem
*.key
*.pfx
*.p12
.env*
!tests/ssh-keys/*.pem

# Syncthing device-local state; shared rules are tracked separately
/.stignore
/.stfolder
/.stversions/
__pycache__/
*.pyc

# Password-encrypted Team migration archives contain private source records.
*.ttmigration

# Private database upgrade backups
*.dump

*.ttsettings*
