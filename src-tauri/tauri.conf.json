{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TermTerm",
  "version": "0.3.3",
  "identifier": "local.termterm.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TermTerm",
        "width": 1440,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 680,
        "backgroundColor": "#161b22"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Encrypted SSH workspace",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../docs/licenses/": "licenses/",
      "../docs/THIRD_PARTY.md": "THIRD_PARTY.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/EnezMutluoglu/TermTerm/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFQzhEODM2OUQyN0Q3NkIKUldScjF5ZWROdGpJcmpQZ3BWSXNyRUVEWnF3RFhSak1ONDF1a0V2ZXRpSUNoODdTdThUaW9HRFEK"
    }
  }
}
