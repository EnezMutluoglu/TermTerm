{
  "bundle": {
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "resources": {
      "resources/mosh-native/": "mosh/"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "libudev1",
          "libssl3",
          "libdbus-1-3",
          "libgcc-s1",
          "libc6 (>= 2.34)"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      },
      "rpm": {
        "depends": [
          "libwebkit2gtk-4.1.so.0()(64bit)",
          "libgtk-3.so.0()(64bit)",
          "libayatana-appindicator3.so.1()(64bit)",
          "libudev.so.1()(64bit)",
          "libssl.so.3()(64bit)",
          "libdbus-1.so.3()(64bit)",
          "libc.so.6(GLIBC_2.34)(64bit)"
        ]
      }
    }
  }
}
